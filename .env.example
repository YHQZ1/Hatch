# Configuration for `hatch serve` and `hatch worker` (and `hatch migrate`,
# which needs only DATABASE_URL). Copy to .env in the repository root.
# `hatch serve` runs the API, web UI, and workers, so it reads every group;
# `hatch worker` runs only the workers and skips the last group.
# Many of these go away later in Phase 1 (RabbitMQ, Redis, JWT, and the hosted
# AWS settings).

# ─── Shared (serve and worker) ───────────────────────────────────────────────
ENVIRONMENT=development
DATABASE_URL=postgres://hatch:hatch@localhost:5433/hatch?sslmode=disable
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AWS_REGION=ap-south-1
# Encrypts tokens and env vars stored in Postgres. Optional in development
# (values are stored unencrypted without it); required, 32+ characters, in
# production. Must not change once data is stored.
DATA_ENCRYPTION_KEY=

# ─── Build worker (serve and worker) ─────────────────────────────────────────
ECR_REGISTRY=your-account-id.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPOSITORY=hatch-builds
BUILD_TIMEOUT=30m

# ─── Deploy worker (serve and worker; serve also uses the first two for metrics)
ECS_CLUSTER_NAME=hatch-cluster
ALB_LISTENER_ARN=arn:aws:elasticloadbalancing:ap-south-1:your-account-id:listener/app/your-alb/your-listener-id
# Optional: used instead of ALB_LISTENER_ARN when set.
ALB_HTTPS_LISTENER_ARN=
# Where deployed apps are reached: <subdomain>.<BASE_DOMAIN>. DEPLOYMENT_URL_SCHEME
# is optional and defaults to https when ALB_HTTPS_LISTENER_ARN is set, else http.
BASE_DOMAIN=your-domain.com
DEPLOYMENT_URL_SCHEME=
VPC_ID=vpc-your-vpc-id
SUBNET_A=subnet-your-subnet-a
SUBNET_B=subnet-your-subnet-b
ECS_SG_ID=sg-your-security-group-id
TASK_EXECUTION_ROLE_ARN=arn:aws:iam::your-account-id:role/hatch-ecs-task-execution

# ─── API and web UI (serve only) ─────────────────────────────────────────────
PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
WEBHOOK_BASE_URL=https://your-domain.com
JWT_SECRET=your-strong-jwt-secret-min-32-chars
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/auth/callback
# Optional: load balancer for project metrics.
ALB_ARN=
