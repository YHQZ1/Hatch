# Configuration for `hatch serve` and `hatch worker` (and `hatch migrate`,
# which needs only DATABASE_URL). Copy to .env in the repository root.
# `hatch serve` runs the API, web UI, and workers, so it reads every group;
# `hatch worker` runs only the workers and skips the last group.
# Many of these go away later in Phase 1 (the hosted AWS settings).

# ─── Where apps are built and run (serve and worker) ─────────────────────────
# local (the default): builds and runs apps with this machine's Docker, served at
#   http://<name>.localhost:8081 by the proxy built into `hatch serve`. Needs
#   Docker running and none of the AWS settings below.
# aws: the old hosted prototype's path. Needs every AWS setting below.
HATCH_TARGET=local
# Local target only: where the app proxy listens. Keep it on 127.0.0.1.
LOCAL_PROXY_ADDR=127.0.0.1:8081

# ─── Shared (serve and worker) ───────────────────────────────────────────────
# "production" logs JSON and turns on the production checks below.
ENVIRONMENT=development
# Optional: debug, info (the default), warn, or error.
LOG_LEVEL=
DATABASE_URL=postgres://hatch:hatch@localhost:5433/hatch?sslmode=disable
AWS_REGION=ap-south-1
# Encrypts tokens and env vars stored in Postgres. Optional in development
# (values are stored unencrypted without it); required, 32+ characters, in
# production. Must not change once data is stored.
DATA_ENCRYPTION_KEY=

# ─── Build worker (serve and worker) ─────────────────────────────────────────
BUILD_TIMEOUT=30m

# ─── AWS target only (HATCH_TARGET=aws) ──────────────────────────────────────
ECR_REGISTRY=your-account-id.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPOSITORY=hatch-builds

# Deploy (serve also uses the first two for metrics)
ECS_CLUSTER_NAME=hatch-cluster
ALB_LISTENER_ARN=arn:aws:elasticloadbalancing:ap-south-1:your-account-id:listener/app/your-alb/your-listener-id
# Optional: used instead of ALB_LISTENER_ARN when set.
ALB_HTTPS_LISTENER_ARN=
# Where deployed apps are reached: <subdomain>.<BASE_DOMAIN>. DEPLOYMENT_URL_SCHEME
# is optional and defaults to https when ALB_HTTPS_LISTENER_ARN is set, else http.
BASE_DOMAIN=your-domain.com
DEPLOYMENT_URL_SCHEME=
VPC_ID=vpc-your-vpc-id
SUBNET_A=subnet-your-subnet-a
SUBNET_B=subnet-your-subnet-b
ECS_SG_ID=sg-your-security-group-id
TASK_EXECUTION_ROLE_ARN=arn:aws:iam::your-account-id:role/hatch-ecs-task-execution

# ─── API and web UI (serve only) ─────────────────────────────────────────────
PORT=8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Your GitHub App (see docs/07-github-app-setup.md). The slug is the last part
# of github.com/apps/<slug>, not a URL. The Client ID starts with "Iv".
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/auth/callback
# The App's private key (a .pem file, generated on the App's settings page).
# Builds use it to get a short-lived, read-only token for one repository.
# Keep the file out of git (*.pem is ignored) and out of images.
GITHUB_APP_PRIVATE_KEY_PATH=your-app.private-key.pem
# Optional: the secret of the App's webhook, which lets a push deploy projects
# that have "deploy on every push" on (see docs/07-github-app-setup.md). GitHub
# must be able to reach this server to send it. At least 16 characters, for
# example `openssl rand -hex 32`. Without it pushes deploy nothing.
GITHUB_WEBHOOK_SECRET=
# Optional, and the two go together: let users connect their own AWS account.
# HATCH_AWS_PRINCIPAL_ARN is the AWS identity this Hatch assumes roles from (an
# IAM role, user or account ARN); the hatch-control role in the user's account
# trusts it. HATCH_CONNECT_TEMPLATE_URL is an https address the hatch-connect
# template is published at in S3 (deploy/cloudformation/hatch-connect.yaml);
# CloudFormation fetches it from there. Without them connecting is switched off.
HATCH_AWS_PRINCIPAL_ARN=
HATCH_CONNECT_TEMPLATE_URL=
# Optional: load balancer for project metrics.
ALB_ARN=
