# OS and editors
.DS_Store
.idea/
.vscode/
*.swp

# Environment and secrets (examples are committed)
.env
.env.*
!.env.example
*.pem
*.key

# Go
/bin/
*.test
coverage.out
coverage.html

# Web (web/dist/.gitkeep stays so `go build` works before the first web build)
node_modules/
web/dist/*
!web/dist/.gitkeep
*.tsbuildinfo

# Local runtime files
*.log
.hatch-dev.pids

# Generated sqlc code in internal/store/db/ is committed on purpose, so CI and
# builds do not need sqlc installed.
