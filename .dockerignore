# Build context for the hatch image (built from the repo root:
#   docker build -t hatch .).
# Patterns without a leading **/ only match at the root.

# Secrets and local config: never send them to the Docker daemon.
**/.env
**/.env.*
!**/.env.example
**/*.tfstate
**/*.tfstate.*
**/*.tfvars

# VCS, tooling, and OS files
.git
.github
**/.DS_Store
**/*.log

# Not needed by the Go builds
**/node_modules
**/.next
**/.terraform
docs
infra
apps/web
