# Web app settings, inlined at build time. `make dev` copies this file to
# .env.development.local when that file is missing.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# How deployed apps' URLs are shown: <subdomain>.<base domain>.
NEXT_PUBLIC_DEPLOYMENT_URL_SCHEME=https
NEXT_PUBLIC_USER_APP_BASE_DOMAIN=your-domain.com
