# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Redis
REDIS_URL=redis://localhost:6379

# AWS Configuration
AWS_REGION=ap-south-1
ECR_REGISTRY=your-account-id.dkr.ecr.ap-south-1.amazonaws.com
ECR_REPOSITORY=hatch-builds

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/hatch?sslmode=disable
DATA_ENCRYPTION_KEY=your-shared-secret-encryption-key-min-32-chars

# GitHub OAuth
GITHUB_CLIENT_ID=GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=GITHUB_CLIENT_SECRET
