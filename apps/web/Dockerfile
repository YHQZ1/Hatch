FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_DEPLOYMENT_URL_SCHEME
ARG NEXT_PUBLIC_USER_APP_BASE_DOMAIN
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_DEPLOYMENT_URL_SCHEME=$NEXT_PUBLIC_DEPLOYMENT_URL_SCHEME
ENV NEXT_PUBLIC_USER_APP_BASE_DOMAIN=$NEXT_PUBLIC_USER_APP_BASE_DOMAIN
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_DEPLOYMENT_URL_SCHEME
ARG NEXT_PUBLIC_USER_APP_BASE_DOMAIN
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_DEPLOYMENT_URL_SCHEME=$NEXT_PUBLIC_DEPLOYMENT_URL_SCHEME
ENV NEXT_PUBLIC_USER_APP_BASE_DOMAIN=$NEXT_PUBLIC_USER_APP_BASE_DOMAIN
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3000
CMD ["npm", "start"]
